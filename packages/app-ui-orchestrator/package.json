{
  "name": "@skynet/app-ui-orchestrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "echo 'App UI build requires Expo/Next - use build:mobile or build:web'",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "dev:web": "cd apps/web && next dev",
    "build:mobile": "cd apps/mobile && npx expo build",
    "build:web": "cd apps/web && next build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint apps/ shared/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@skynet/blockchain-client": "workspace:*",
    "@skynet/core-wasm-engine": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "1.6.1"
  }
}
